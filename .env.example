# ==============================================================================
# PhishShield - Environment Configuration Template
# Copy this file to '.env' and fill in your Supabase credentials.
# NEVER commit the actual '.env' file to Git or version control!
# ==============================================================================

# Application Branding
SYSTEM_NAME=PhishShield

# Flask Environment ('development' or 'production')
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Secret Key for secure sessions, cookie signatures, and CSRF protection
SECRET_KEY=replace-with-a-random-32-byte-hex-string-for-production

# ------------------------------------------------------------------------------
# SUPABASE CLOUD POSTGRESQL CONNECTION STRINGS
# ------------------------------------------------------------------------------
# models.py is the single source of truth for the database schema.
# SQLAlchemy and Flask-Migrate (Alembic) are used exclusively (NO Supabase SDK / Auth).
#
# 1. DATABASE_URL: Application Runtime Connection (Required)
#    Use Supabase Transaction Pooler (Port 6543) for high concurrency and serverless:
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# 2. MIGRATION_DATABASE_URL: Schema Migrations Connection (Recommended)
#    Use Supabase Session Pooler (Port 5432) or direct connection for DDL migrations.
#    Alembic migrations use this URL, falling back to DATABASE_URL if not set:
MIGRATION_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Cookie Security (set to True when deploying behind HTTPS in production)
COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# THREAT DETECTION (FULLY RULE-BASED & SELF-CONTAINED BY DEFAULT)
# ------------------------------------------------------------------------------
# By default, detection is 100% self-contained and offline-capable using local
# heuristics, the KNOWN_BAD_DOMAINS list in config.py, and the blocked_sender table.
# When ENABLE_VIRUSTOTAL is False, the app NEVER calls VirusTotal or any external service.
ENABLE_VIRUSTOTAL=False

# Only read and used if ENABLE_VIRUSTOTAL is set to True
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
